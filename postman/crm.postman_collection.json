{
  "info": {
    "name": "CRM API Practice",
    "description": "A new educational demo prepared with AI assistance for Karina to review and practice. Synthetic data only. Run the complete collection in order against the local Python API. This is not prior client work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "created_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 Reset deterministic fixture",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/test/reset",
        "description": "Expected HTTP 200. Reset deterministic fixture.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"HTTP status is 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
              "pm.test(\"Response is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Response matches the scenario\", function () {",
              "  pm.expect(body).to.eql({reset: true, count: 3});",
              "});",
              "pm.collectionVariables.unset(\"created_id\");"
            ]
          }
        }
      ]
    },
    {
