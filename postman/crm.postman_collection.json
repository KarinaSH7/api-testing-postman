              "  pm.expect(body).to.eql({status: \"ok\", storage: \"memory\"});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List three seeded contacts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/contacts",
        "description": "Expected HTTP 200. List three seeded contacts."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"HTTP status is 200\", function () { pm.expect(pm.response.code).to.equal(200); });",
              "pm.test(\"Response is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Response matches the scenario\", function () {",
              "  pm.expect(body.data.map(c => c.id)).to.eql([1, 2, 3]);",
              "  pm.expect(body.meta).to.eql({total: 3, limit: 20, offset: 0});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Filter active contacts",
      "request": {
        "method": "GET",
        "header": [],
